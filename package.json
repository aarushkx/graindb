{
  "name": "graindb",
  "version": "1.0.0",
  "description": "A small persistent key-value database served over HTTP",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bench:put": "tsx src/bench/put-benchmark.ts",
    "bench:get": "tsx src/bench/get-benchmark.ts",
    "build": "tsc",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["database", "key-value", "persistent", "HTTP"],
  "author": "Aarush Kumar",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
